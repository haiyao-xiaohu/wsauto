# OKX Developer Portal credentials (never commit real values)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_API_PASSPHRASE=
OKX_PROJECT_ID=

# Safety: both values must be true before any transaction can be broadcast.
LIVE_TRADING=false
I_UNDERSTAND_LIVE_TRADING_RISK=false

# Request/risk controls
OKX_REQUEST_TIMEOUT_MS=3000
MAX_PRICE_IMPACT_PERCENT=10
MAX_TOKEN_TAX_RATE=0.10

# Optional local wallet allowlist. Leave blank when the upstream system has
# already selected reliable wallets.
BSC_WATCH_WALLETS=
RESONANCE_THRESHOLD=2
RESONANCE_WINDOW_SECONDS=30
RESONANCE_COOLDOWN_SECONDS=600
MAX_SIGNAL_AGE_SECONDS=15
RESONANCE_BUILD_SWAP=false
RESONANCE_ORDER_AMOUNT_BNB=0.001
RESONANCE_MAX_ORDER_AMOUNT_BNB=0.01
RESONANCE_SLIPPAGE_PERCENT=1

# QuickNode Streams Webhook
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080
WEBHOOK_MAX_BODY_BYTES=5242880
# Optional during dry-run. If configured, X-QN-* signatures are verified.
QUICKNODE_STREAM_SECRET=

# EVM wallet and RPC endpoints
# Use a fresh, low-balance test wallet. Do not paste a primary-wallet key.
# Dry-run only needs the public address. Live trading additionally needs the key.
EVM_WALLET_ADDRESS=
EVM_PRIVATE_KEY=
ETHEREUM_RPC_URL=
BSC_RPC_URL=
# 备用 BSC RPC（多个用逗号分隔），主节点限流/失败时自动切换
BSC_RPC_URL_2=
BSC_WSS_URL=
BASE_RPC_URL=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# ── Robinhood Chain (Rob) 独立配置 ──
# Rob 链 QuickNode 流验签密钥（独立于 BSC）
QUICKNODE_ROB_STREAM_SECRET=
# Rob 链监控錢包列表（独立于 BSC 共振錢包）
ROB_WATCH_WALLETS=
ROB_WALLET_LIST_PATH=
# Rob 链共振参数
ROB_RESONANCE_THRESHOLD=2
ROB_RESONANCE_WINDOW_SECONDS=30
ROB_RESONANCE_COOLDOWN_SECONDS=600
ROB_RESONANCE_ORDER_AMOUNT_ETH=0.0001
# Rob 链实局交易开关（需要 LIVE_TRADING=true 才生效）
WEBHOOK_ROB_LIVE_TRADING=false

# Solana wallet and RPC
# Accepts a base58 secret key or a JSON byte array.
SOLANA_WALLET_ADDRESS=
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=

# ── GMGN 限价挂单 ──
# GMGN CLI 配置路径: ~/.config/gmgn/.env (API Key) + keypair.pem
# 验证: npx gmgn-cli config --check
# 写入: npx gmgn-cli config --apply <api_key>
# IP 白名单需在 GMGN Dashboard 手动添加，否则报 AUTH_IP_NOT_SUPPORTED
# GMGN_ALLOW_AUTOMATED_TRADES=1 由代码自动注入子进程，无需在此配置

# Dashboard 登录密码：必须设置，无默认值
DASHBOARD_PASSWORD=

# Optional integration-test signal wallets (local values only)
TEST_WATCH_WALLET_1=
TEST_WATCH_WALLET_2=

# Optional manual-test targets; never commit real transaction history
TOKEN_ADDRESS=
TEST_TX_HASH=
